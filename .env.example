# Скопіюй у .env і заповни. Файл .env у git НЕ потрапляє.

# База даних: формат Render (postgres://...) або Npgsql (Host=...;Database=...)
DATABASE_URL=postgres://postgres:password@localhost:5432/kastomni_mebli

# Telegram: токен від @BotFather і id чату (групи або кількох людей через кому)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Контакти на сайті (необов'язково — інакше беруться з appsettings.json)
# Site__Phone=+380 67 123 45 67
# Site__Telegram=kastomni_mebli
