@inherits LayoutComponentBase
@inject IOptions<SiteSettings> SiteOptions

<a class="skip-link" href="#main">До змісту</a>

<header class="site-header">
    <div class="container header-row">
        <a class="logo" href="/">
            <svg class="logo-mark" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" />
                <line x1="12" y1="3" x2="12" y2="21" />
                <line x1="3" y1="8" x2="21" y2="8" />
            </svg>
            <span>@Site.Brand</span>
        </a>
        <nav class="header-nav" aria-label="Розділи">
            <a href="/#shcho-robymo">Що робимо</a>
            <a href="/#yak-pratsyuiemo">Як працюємо</a>
            <a href="/roboty">Роботи</a>
            <a href="/#komanda">Команда</a>
            <a href="/#pytannia">Питання</a>
        </nav>
        <div class="header-actions">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Темна тема" title="Темна тема">☾</button>
            @if (Site.PhoneHref is { } tel)
            {
                <a class="header-phone mono" href="@tel">@Site.Phone</a>
            }
            @if (IsB2b)
            {
                <a class="btn btn-primary btn-sm" href="#zavdannia">Передати завдання</a>
            }
            else
            {
                <a class="btn btn-primary btn-sm" href="/#zayavka">Замовити замір</a>
            }
        </div>
    </div>
</header>

<main id="main">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="title-block">
            <div class="tb-cell tb-brand">
                <span class="tb-label">Виконавець</span>
                <span class="tb-value tb-strong">@Site.Brand</span>
            </div>
            <div class="tb-cell">
                <span class="tb-label">Де працюємо</span>
                <span class="tb-value">@Site.AreasText</span>
            </div>
            <div class="tb-cell">
                <span class="tb-label">Телефон</span>
                <span class="tb-value mono">
                    @if (Site.PhoneHref is { } footerTel)
                    {
                        <a href="@footerTel">@Site.Phone</a>
                    }
                    else
                    {
                        <a href="/#zayavka">залиште заявку</a>
                    }
                </span>
            </div>
            @if (Site.TelegramHref is { } tg)
            {
                <div class="tb-cell">
                    <span class="tb-label">Telegram</span>
                    <span class="tb-value mono"><a href="@tg" rel="noopener">@@@Site.Telegram.TrimStart('@')</a></span>
                </div>
            }
            <div class="tb-cell">
                <span class="tb-label">Меблярам</span>
                <span class="tb-value"><a href="/dlya-meblyariv">Креслення на замовлення</a></span>
            </div>
            <div class="tb-cell tb-small">
                <span class="tb-label">Рік</span>
                <span class="tb-value mono">@DateTime.UtcNow.Year</span>
            </div>
        </div>
        <p class="footer-legal small"><a href="/konfidentsiinist">Політика конфіденційності</a></p>
    </div>
</footer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private SiteSettings Site => SiteOptions.Value;

    private bool IsB2b => HttpContext?.Request.Path.StartsWithSegments("/dlya-meblyariv") == true;
}
