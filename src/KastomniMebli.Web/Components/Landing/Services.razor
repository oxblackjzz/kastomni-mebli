<section class="section" id="shcho-robymo">
    <div class="container">
        <p class="sheet-label"><span class="mono">02</span> Що робимо</p>
        <h2>Корпусні меблі під ваш розмір</h2>
        <ul class="card-grid">
            @foreach (var (tag, title, text) in Items)
            {
                <li class="card">
                    <h3>@title</h3>
                    <p>@text</p>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private static readonly (string Code, string Title, string Text)[] Items =
    [
        ("Ш-01", "Шафи-купе", "Від підлоги до стелі й від стіни до стіни: розсувні двері, дзеркало, антресолі, наповнення під ваші речі."),
        ("Г-02", "Гардеробні", "Системи зберігання для окремої кімнати чи кута: штанги, полиці, шухляди, секції для взуття."),
        ("К-03", "Кухні", "Під конкретну техніку, з урахуванням котла, розеток і виводу води."),
        ("П-04", "Передпокої", "Шафи й тумби для вузьких коридорів — без жодного зайвого сантиметра."),
        ("Д-05", "Дитячі та спальні", "Шафи, стелажі, комоди, робочі місця — під кімнату й під того, хто в ній живе."),
        ("Н-06", "Нестандартне", "Під сходи, у мансарди зі скосами, ніші з балками й виступами."),
    ];
}
